# ===== 必填 =====
# CodeHub 仓库地址（SSH 推荐，如 git@codehub.example.com:team/docs.git）
REPO_URL=
# 会话签名密钥（openssl rand -hex 32 生成）
AUTH_SECRET=
# webhook 验签 token，配在 CodeHub webhook URL 的 ?token= 上
# （也可部署后在「平台管理 → Webhook」界面配置/生成，界面配置优先于此变量）
WEBHOOK_SECRET=

# ===== 可选 =====
# 分支，默认 main
REPO_BRANCH=main
# SSH deploy key 在容器内的路径（REPO_URL 为 SSH 地址时必填）
GIT_SSH_KEY=/keys/deploy_key
# 轮询兜底间隔（毫秒），默认 600000（10 分钟）
POLL_INTERVAL_MS=600000
# 数据目录（SQLite + 仓库克隆），默认 ./data，Docker 中为 /data
DATA_DIR=./data
# 初始管理员账号（仅首次启动播种数据库时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# git committer 身份（author 始终是实际操作的用户）
GIT_BOT_NAME=gitmd-bot
GIT_BOT_EMAIL=gitmd@local
# 端口
PORT=3000

# ===== 网络代理（可选）=====
# 启动钩子会把 EnvHttpProxyAgent 装为全局调度器：进程内所有 Node fetch
# （外链图片转存等）按下面的标准变量逐 URL 走代理或直连（Node 全局 fetch 默认不读）。
# git 走子进程：HTTPS 远端原生读这些变量；SSH 远端需代理时请在 ssh config 配 ProxyCommand。
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# 需要绕过代理的内网地址（图床/仓库在内网时务必设置，否则内网请求会被送进代理）：
# NO_PROXY=localhost,127.0.0.1,.internal.example.com
